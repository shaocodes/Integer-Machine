exports[`operand input handling > accepts decimal and binary operands interchangeably 1`] = `
{
  "mode": "unsigned",
  "bits": 8,
  "accBits": 10,
  "dividend": {
    "decimal": "200",
    "binary": "11001000",
    "grouped": "1100 1000"
  },
  "divisor": {
    "decimal": "7",
    "binary": "00000111",
    "grouped": "0000 0111"
  },
  "quotient": {
    "decimal": "28",
    "binary": "00011100",
    "grouped": "0001 1100"
  },
  "remainder": {
    "decimal": "4",
    "binary": "00000100",
    "grouped": "0000 0100"
  },
  "steps": [
    {
      "index": 1,
      "iteration": 0,
      "kind": "init",
      "action": "Initialise",
      "a": "0000000000",
      "q": "11001000",
      "m": "00000111",
      "aValue": "0n",
      "qValue": "200n",
      "q0": null,
      "note": "A is cleared, Q holds the dividend magnitude 200, M holds the divisor magnitude 7. The loop runs 8 times, once per bit of Q."
    },
    {
      "index": 2,
      "iteration": 1,
      "kind": "shift",
      "action": "Shift left [A,Q]",
      "a": "0000000001",
      "q": "10010000",
      "m": "00000111",
      "aValue": "1n",
      "qValue": "144n",
      "q0": null,
      "note": "Bit 1 shifts out of Q into A. Q0 is left empty for this iteration's quotient bit."
    },
    {
      "index": 3,
      "iteration": 1,
      "kind": "subtract",
      "action": "A <- A - M",
      "a": "1111111010",
      "q": "10010000",
      "m": "00000111",
      "aValue": "-6n",
      "qValue": "144n",
      "q0": 0,
      "note": "A was non-negative before the shift, so M is subtracted. A is now negative, so Q0 = 0."
    },
    {
      "index": 4,
      "iteration": 2,
      "kind": "shift",
      "action": "Shift left [A,Q]",
      "a": "1111110101",
      "q": "00100000",
      "m": "00000111",
      "aValue": "-11n",
      "qValue": "32n",
      "q0": null,
      "note": "Bit 1 shifts out of Q into A. Q0 is left empty for this iteration's quotient bit."
    },
    {
      "index": 5,
      "iteration": 2,
      "kind": "add",
      "action": "A <- A + M",
      "a": "1111111100",
      "q": "00100000",
      "m": "00000111",
      "aValue": "-4n",
      "qValue": "32n",
      "q0": 0,
      "note": "A was negative before the shift, so M is added back instead of subtracted — this is the deferred restore. A is now negative, so Q0 = 0."
    },
    {
      "index": 6,
      "iteration": 3,
      "kind": "shift",
      "action": "Shift left [A,Q]",
      "a": "1111111000",
      "q": "01000000",
      "m": "00000111",
      "aValue": "-8n",
      "qValue": "64n",
      "q0": null,
      "note": "Bit 0 shifts out of Q into A. Q0 is left empty for this iteration's quotient bit."
    },
    {
      "index": 7,
      "iteration": 3,
      "kind": "add",
      "action": "A <- A + M",
      "a": "1111111111",
      "q": "01000000",
      "m": "00000111",
      "aValue": "-1n",
      "qValue": "64n",
      "q0": 0,
      "note": "A was negative before the shift, so M is added back instead of subtracted — this is the deferred restore. A is now negative, so Q0 = 0."
    },
