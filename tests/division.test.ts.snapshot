exports[`step-by-step trace > follows the documented register sequence for 7 / 2 in 4 bits 1`] = `
[
  "Initialise A=000000 Q=0111",
  "Shift left [A,Q] A=000000 Q=1110",
  "A <- A - M A=111110 Q=1110",
  "Shift left [A,Q] A=111101 Q=1100",
  "A <- A + M A=111111 Q=1100",
  "Shift left [A,Q] A=111111 Q=1000",
  "A <- A + M A=000001 Q=1001",
  "Shift left [A,Q] A=000011 Q=0010",
  "A <- A - M A=000001 Q=0011"
]
`;

exports[`step-by-step trace > follows the documented register sequence for 7 / 2 in 4 bits 2`] = `
"0011"
`;

exports[`step-by-step trace > formats a readable table 1`] = `
"unsigned division, 8-bit operands\\nDividend M/Q: 200 (11001000)\\nDivisor  M  : 7 (00000111)\\n\\n#   It  Operation         A           Q         Q0\\n--  --  ----------------  ----------  --------  --\\n1   -   Initialise        0000000000  11001000  -\\n2   1   Shift left [A,Q]  0000000001  10010000  -\\n3   1   A <- A - M        1111111010  10010000  0\\n4   2   Shift left [A,Q]  1111110101  00100000  -\\n5   2   A <- A + M        1111111100  00100000  0\\n6   3   Shift left [A,Q]  1111111000  01000000  -\\n7   3   A <- A + M        1111111111  01000000  0\\n8   4   Shift left [A,Q]  1111111110  10000000  -\\n9   4   A <- A + M        0000000101  10000001  1\\n10  5   Shift left [A,Q]  0000001011  00000010  -\\n11  5   A <- A - M        0000000100  00000011  1\\n12  6   Shift left [A,Q]  0000001000  00000110  -\\n13  6   A <- A - M        0000000001  00000111  1\\n14  7   Shift left [A,Q]  0000000010  00001110  -\\n15  7   A <- A - M        1111111011  00001110  0\\n16  8   Shift left [A,Q]  1111110110  00011100  -\\n17  8   A <- A + M        1111111101  00011100  0\\n18  -   A <- A + M        0000000100  00011100  -\\n\\nQuotient : 28 (00011100)\\nRemainder: 4 (00000100)\\nCheck    : (28 x 7) + 4 = 200 = 200"
`;

