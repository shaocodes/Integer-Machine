      "aValue": "1n",
      "qValue": "7n",
      "q0": 1,
      "note": "A was non-negative before the shift, so M is subtracted. A is now non-negative, so Q0 = 1."
    },
    {
      "index": 14,
      "iteration": 7,
      "kind": "shift",
      "action": "Shift left [A,Q]",
      "a": "0000000010",
      "q": "00001110",
      "m": "00000111",
      "aValue": "2n",
      "qValue": "14n",
      "q0": null,
      "note": "Bit 0 shifts out of Q into A. Q0 is left empty for this iteration's quotient bit."
    },
    {
      "index": 15,
      "iteration": 7,
      "kind": "subtract",
      "action": "A <- A - M",
      "a": "1111111011",
      "q": "00001110",
      "m": "00000111",
      "aValue": "-5n",
      "qValue": "14n",
      "q0": 0,
      "note": "A was non-negative before the shift, so M is subtracted. A is now negative, so Q0 = 0."
    },
    {
      "index": 16,
      "iteration": 8,
      "kind": "shift",
      "action": "Shift left [A,Q]",
      "a": "1111110110",
      "q": "00011100",
      "m": "00000111",
      "aValue": "-10n",
      "qValue": "28n",
      "q0": null,
      "note": "Bit 0 shifts out of Q into A. Q0 is left empty for this iteration's quotient bit."
    },
    {
      "index": 17,
      "iteration": 8,
      "kind": "add",
      "action": "A <- A + M",
      "a": "1111111101",
      "q": "00011100",
      "m": "00000111",
      "aValue": "-3n",
      "qValue": "28n",
      "q0": 0,
      "note": "A was negative before the shift, so M is added back instead of subtracted — this is the deferred restore. A is now negative, so Q0 = 0."
    },
    {
      "index": 18,
      "iteration": 0,
      "kind": "restore",
      "action": "A <- A + M",
      "a": "0000000100",
      "q": "00011100",
      "m": "00000111",
      "aValue": "4n",
      "qValue": "28n",
      "q0": null,
      "note": "The loop ended with a negative A, so one corrective addition restores the true remainder. This happens at most once in the whole division."
    }
  ],
  "signs": null,
  "summary": "200 / 7 = 28 remainder 4",
  "verification": "(28 x 7) + 4 = 200 = 200"
}
`;

