[
  "Initialise C=0 A=0000 Q=0011",
  "C,A <- A + M C=0 A=0101 Q=0011",
  "Shift right [C,A,Q] C=0 A=0010 Q=1001",
  "C,A <- A + M C=0 A=0111 Q=1001",
  "Shift right [C,A,Q] C=0 A=0011 Q=1100",
  "No operation C=0 A=0011 Q=1100",
  "Shift right [C,A,Q] C=0 A=0001 Q=1110",
  "No operation C=0 A=0001 Q=1110",
  "Shift right [C,A,Q] C=0 A=0000 Q=1111"
]
`;

exports[`step-by-step trace > formats a readable table 1`] = `
"unsigned multiplication, 8-bit operands\\nMultiplicand M: 13 (00001101)\\nMultiplier   Q: 11 (00001011)\\n\\n#   It  Operation            C  A         Q\\n--  --  -------------------  -  --------  --------\\n1   -   Initialise           0  00000000  00001011\\n2   1   C,A <- A + M         0  00001101  00001011\\n3   1   Shift right [C,A,Q]  0  00000110  10000101\\n4   2   C,A <- A + M         0  00010011  10000101\\n5   2   Shift right [C,A,Q]  0  00001001  11000010\\n6   3   No operation         0  00001001  11000010\\n7   3   Shift right [C,A,Q]  0  00000100  11100001\\n8   4   C,A <- A + M         0  00010001  11100001\\n9   4   Shift right [C,A,Q]  0  00001000  11110000\\n10  5   No operation         0  00001000  11110000\\n11  5   Shift right [C,A,Q]  0  00000100  01111000\\n12  6   No operation         0  00000100  01111000\\n13  6   Shift right [C,A,Q]  0  00000010  00111100\\n14  7   No operation         0  00000010  00111100\\n15  7   Shift right [C,A,Q]  0  00000001  00011110\\n16  8   No operation         0  00000001  00011110\\n17  8   Shift right [C,A,Q]  0  00000000  10001111\\n\\nProduct: 143 (0000000010001111)\\nA:Q    : 00000000 10001111"
`;

